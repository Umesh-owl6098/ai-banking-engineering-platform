# Copy to .env and fill in local values. Never commit .env.

# OpenAI (optional — reports use deterministic fallback without it)
OPENAI_API_KEY=your-openai-api-key-here

# Frontend (optional overrides)
VITE_API_URL=http://localhost:8080/api
VITE_PROJECT_ID=8c0c0dee-dd8e-4419-bef3-a2e93c10a726

# Backend database (defaults match docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/banking_platform
SPRING_DATASOURCE_USERNAME=banking_user
SPRING_DATASOURCE_PASSWORD=your-local-db-password

# JWT (override for non-local environments)
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
AUTH_JWT_EXPIRATION_MS=86400000

# Demo users (disable in production)
AUTH_DEMO_USERS_ENABLED=true
DEMO_USER_PASSWORD=your-local-demo-password

# Screenshot automation (local only — never commit real values)
DEMO_USERNAME=supervisor
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080/api
